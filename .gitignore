# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production is committed on purpose: it only holds the public
# Supabase URL + anon/publishable key (protected by RLS, safe to expose
# client-side), so Vercel builds pick it up with no manual dashboard step.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local NPS data files (never commit real customer data)
/data/
*.csv
