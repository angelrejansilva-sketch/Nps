# Public Supabase config — actual values live in .env.production (committed on purpose).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for the "Análise por IA" feature (src/app/api/ask-ai). This is a real
# secret (server-side only, never NEXT_PUBLIC_) — do NOT commit it. Get a key at
# https://console.anthropic.com/settings/keys and set it:
#   - locally: add it to .env.local (already gitignored)
#   - in production: Vercel dashboard → Project → Settings → Environment Variables
ANTHROPIC_API_KEY=
