# Public Supabase config — actual values live in .env.production (committed on purpose).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for the "Análise por IA" feature (src/app/api/ask-ai). This is a real
# secret (server-side only, never NEXT_PUBLIC_) — do NOT commit it. Get a key at
# https://console.anthropic.com/settings/keys and set it:
#   - locally: add it to .env.local (already gitignored)
#   - in production: Vercel dashboard → Project → Settings → Environment Variables
ANTHROPIC_API_KEY=

# Required for the automated sync endpoints (src/app/api/sync/*) that let the
# local Python pipeline (tratar_base_nps.py) push new rows straight into
# Supabase instead of a manual CSV upload. Both are real secrets — never
# commit them, set them in Vercel → Project → Settings → Environment Variables.
#
# SUPABASE_SERVICE_ROLE_KEY: bypasses RLS — get it from the Supabase dashboard
# (Project Settings → API → service_role key). Used ONLY server-side in the
# sync routes, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
#
# SYNC_API_KEY: an arbitrary shared secret (not from Supabase) that the sync
# routes check on every request via `Authorization: Bearer <value>` — this is
# what stops anyone else from calling /api/sync/*. Generate any long random
# string and put the same value in the Python script's config.
SYNC_API_KEY=
